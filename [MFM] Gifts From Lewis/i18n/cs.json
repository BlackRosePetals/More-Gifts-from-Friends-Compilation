//Czech Translation
//cs.json
{
"lewis_1": "Ahoj, @.^ ^Chtěl bych ti poděkovat za to, že ses stal tak důležitou součástí naší komunity. Prosím, přijmi tento malý projev mého uznání.^ ^— Lewis",
"lewis_2": "Ahoj, @.^ ^Naše městečko má velké štěstí, že má někoho, jako jsi ty, kdo z něj dělá ještě lepší místo. Doufám, že ti tento dárek udělá radost.^ ^— Lewis",
"lewis_3": "Ahoj, @.^ ^Jako starosta mám vždy radost, když vidím, jak v naší komunitě vznikají nová přátelství. Ber to jako malý projev mé vděčnosti.^ ^— Lewis",
"lewis_4": "Ahoj, @.^ ^Stal ses důležitou součástí naší komunity. Doufám, že si budeš i nadále užívat vše, co může údolí nabídnout.^ ^— Lewis",
"lewis_5": "Ahoj, @.^ ^Jako starosta často dostávám dárky a projevy uznání. Napadlo mě, že nastal čas podělit se o část této štědrosti i s tebou.^ ^— Lewis",
"lewis_6": "Ahoj, @.^ ^Silná komunita je postavena na důvěře a přátelství. Jsem rád, že tě mohu považovat za přítele Pelican Town.^ ^— Lewis",
"lewis_7": "Ahoj, @.^ ^Vždy mě těší vidět, jak pozitivně přispíváš naší komunitě. Přijmi tento dárek jako výraz mé vděčnosti.^ ^— Lewis",
"lewis_8": "Ahoj, @.^ ^Za ta léta jsem poznal, že opravdové přátelství je tím největším pokladem, který může starosta mít. Děkuji, že jsi součástí naší komunity.^ ^— Lewis",
"lewis_9": "Ahoj, @.^ ^Tvé odhodlání a laskavost nezůstaly bez povšimnutí. Je pro mě ctí, že mezi obyvateli Pelican Town žije někdo jako ty.^ ^— Lewis",
"lewis_10": "Ahoj, @.^ ^Po všem, co jsi udělal pro sebe i pro naši komunitu, jsem ti chtěl darovat něco opravdu výjimečného. Děkuji, že jsi tak vzácným přítelem.^ ^— Lewis",
"lewis_repeatable": "Ahoj, @.^ ^Našli jsme několik věcí v oddělení ztrát a nálezů na radnici. Protože si je nikdo nepřišel vyzvednout, napadlo mě, že by se ti mohly hodit na farmě.^ ^— Lewis"
}