//Polish Translation
//pl.json
{
"lewis_1": "Cześć, @.^ ^Chciałbym podziękować Ci za to, że stałeś się tak ważną częścią naszej społeczności. Proszę, przyjmij ten drobny wyraz mojej wdzięczności.^ ^— Lewis",
"lewis_2": "Cześć, @.^ ^Nasze miasteczko ma szczęście, że mieszka w nim ktoś taki jak Ty, kto sprawia, że staje się jeszcze lepszym miejscem. Mam nadzieję, że ten prezent sprawi Ci trochę radości.^ ^— Lewis",
"lewis_3": "Cześć, @.^ ^Jako burmistrz zawsze cieszę się, gdy w naszej społeczności rodzą się nowe przyjaźnie. Niech to będzie mały wyraz mojej wdzięczności.^ ^— Lewis",
"lewis_4": "Cześć, @.^ ^Stałeś się ważną częścią naszej społeczności. Mam nadzieję, że nadal będziesz cieszyć się wszystkim, co dolina ma do zaoferowania.^ ^— Lewis",
"lewis_5": "Cześć, @.^ ^Jako burmistrz często otrzymuję prezenty i wyrazy uznania. Pomyślałem, że nadszedł czas, aby podzielić się częścią tej życzliwości z Tobą.^ ^— Lewis",
"lewis_6": "Cześć, @.^ ^Silna społeczność opiera się na zaufaniu i przyjaźni. Cieszę się, że mogę uważać Cię za przyjaciela Pelican Town.^ ^— Lewis",
"lewis_7": "Cześć, @.^ ^Zawsze cieszy mnie widok Twojego pozytywnego wkładu w naszą społeczność. Przyjmij ten prezent jako wyraz mojej wdzięczności.^ ^— Lewis",
"lewis_8": "Cześć, @.^ ^Przez lata nauczyłem się, że prawdziwa przyjaźń jest największym skarbem, jaki może mieć burmistrz. Dziękuję, że jesteś częścią naszej społeczności.^ ^— Lewis",
"lewis_9": "Cześć, @.^ ^Twoje zaangażowanie i życzliwość nie pozostały niezauważone. To dla mnie zaszczyt, że ktoś taki jak Ty mieszka w Pelican Town.^ ^— Lewis",
"lewis_10": "Cześć, @.^ ^Po tym wszystkim, co zrobiłeś dla siebie i dla naszej społeczności, chciałem podarować Ci coś naprawdę wyjątkowego. Dziękuję, że jesteś tak wspaniałym przyjacielem.^ ^— Lewis",
"lewis_repeatable": "Cześć, @.^ ^Znaleźliśmy kilka przedmiotów w Biurze Rzeczy Znalezionych w ratuszu. Ponieważ nikt się po nie nie zgłosił, pomyślałem, że mogą Ci się przydać na farmie.^ ^— Lewis"
}