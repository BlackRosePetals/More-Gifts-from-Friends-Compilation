//Polish Translation
//pl.json
{
  "VincentGift1": "Cześć! Znalazłem te kamienie na dworze! Wyglądały na ważne, więc możesz je zatrzymać! -Vincent",
  "VincentGift2": "Kopałem w ziemi i znalazłem to! Mama mówiła, żebym nie robił bałaganu... tylko jej nie mów! -Vincent",
  "VincentGift3": "Byłem na plaży! Przyniosłem ci to! Trochę dziwnie pachnie. -Vincent",
  "VincentGift4": "Znalazłem to nasionko! Wygląda na strasznie stare... może to jakiś skarb? Możesz je posadzić! -Vincent",
  "VincentGift5": "To rośnie blisko mojego domu! Zebrałem trochę dla ciebie! -Vincent",
  "VincentGift6": "Znalazłem tę zabawkę, ale jest trochę straszna... możesz ją zatrzymać. -Vincent",
  "VincentGift7": "Pozbierałem te nasiona z drzew! Nie wiem, które jest z którego drzewa, ale wszystkie wyglądają fajnie! -Vincent",
  "VincentGift8": "Znalazłem w kuchni ciasteczka! Chyba były dodatkowe, więc możesz je wziąć! -Vincent",
  "VincentGift9": "Znalazłem tę muszelkę! Jest naprawdę śliczna! Powinieneś zachować ją na zawsze. -Vincent",
  "VincentGift10": "Znalazłem to i nie wiem, do czego to służy... ale wygląda, jakby przynosiło szczęście! Więc jest twoje! -Vincent"
}